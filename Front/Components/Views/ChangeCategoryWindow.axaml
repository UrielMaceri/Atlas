<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Front"
        x:Class="Front.ChangeCategoryWindow"
        x:DataType="local:ItemViewModel"
        Title="Change category"
        Width="420"
        Height="420"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#1c1c1c">
    <Border Padding="24"
            Margin="8"
            Background="#292929"
            BorderBrush="#555555"
            BorderThickness="1"
            CornerRadius="8">
        <Grid RowDefinitions="Auto,*,Auto"
              RowSpacing="12">
            <TextBlock Text="Choose a category"
                       FontSize="20"
                       FontWeight="SemiBold" />

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding CategoriesInWorkspace}"
                     SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                     SelectionChanged="OnCategorySelected"
                     MinHeight="180">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:CategoryViewModel">
                        <TextBlock Text="{Binding Name}"
                                   Padding="8,6" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button Content="Cancel"
                        Command="{Binding ChangeCategoryCancel}"
                        Classes="action-button" />
            </StackPanel>
        </Grid>
    </Border>
</Window>