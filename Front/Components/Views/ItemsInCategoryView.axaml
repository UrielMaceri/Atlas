<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Front"
             x:Class="Front.ItemsInCategoryView"
             x:DataType="local:ItemViewModel"
             DragDrop.AllowDrop="True">
    <Grid Classes="item-tile">
        <Button Command="{Binding OpenFileCommand}"
                ToolTip.Tip="{Binding Description}"
                Classes="item-tile-button"
                Background="Transparent"
                BorderBrush="Transparent"
                Padding="0"
                Margin="6">
            <Border Width="90"
                    MinHeight="90"
                    MaxHeight="150"
                    Margin="6"
                    Padding="8"
                    CornerRadius="8"
                    BorderBrush="#4a4a4a"
                    BorderThickness="1">

                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open"
                                Command="{Binding OpenFileCommand}" />
                        <MenuItem Header="Open Path"
                                Command="{Binding OpenPathCommand}" />
                        <MenuItem Header="Rename"
                                Command="{Binding RenameItemCommand}" />
                        <MenuItem Header="Delete"
                                Command="{Binding DeleteItemCommand}" />
                        <MenuItem Header="Change Category"
                                Command="{Binding ChangeCategoryCommand}" />
                    </ContextMenu>
                </Border.ContextMenu>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Image Source="{Binding IconBitmap}"
                        Width="40"
                        Stretch="Uniform" />
                    <TextBlock Text="{Binding Name}"
                            Margin="0,4,0,0"
                            TextWrapping="Wrap"
                            TextTrimming="CharacterEllipsis"
                            TextAlignment="Center"
                            FontSize="11" />
                </StackPanel>
            </Border>
        </Button>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="0,6,6,0"
                    Spacing="2"
                    Panel.ZIndex="1">
            <Button Classes="icon-btn item-move-btn"
                    Command="{Binding MoveUp}"
                    IsEnabled="{Binding CanMoveUp}">
                <PathIcon Data="M15.41,7.41L14,6L8,12L14,18L15.41,16.59L10.83,12Z"
                          Width="16"
                          Height="16"/>
            </Button>
            <Button Classes="icon-btn item-move-btn"
                    Command="{Binding MoveDown}"
                    IsEnabled="{Binding CanMoveDown}">
                <PathIcon Data="M8.59,16.59L10,18L16,12L10,6L8.59,7.41L13.17,12Z"
                          Width="16"
                          Height="16"/>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>