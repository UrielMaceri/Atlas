<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Front"
             x:Class="Front.ItemsInCategoryView"
             x:DataType="local:ItemViewModel"
             DragDrop.AllowDrop="True">
    <DockPanel>
        <Button Command="{Binding OpenFileCommand}"
                ToolTip.Tip="{Binding Description}"
                Classes="item-tile-button"
                Background="Transparent"
                BorderBrush="Transparent"
                Padding="0"
                Margin="6">
            <Border Width="90"
                    MinHeight="90"
                    MaxHeight="150"
                    Margin="6"
                    Padding="8"
                    CornerRadius="8"
                    BorderBrush="#4a4a4a"
                    BorderThickness="1">

                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open"
                                Command="{Binding OpenFileCommand}" />
                        <MenuItem Header="Rename"
                                Command="{Binding RenameItemCommand}" />
                        <MenuItem Header="Delete"
                                Command="{Binding DeleteItemCommand}" />
                        <MenuItem Header="Change Category"
                                Command="{Binding ChangeCategoryCommand}" />
                    </ContextMenu>
                </Border.ContextMenu>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Image Source="{Binding IconBitmap}"
                        Width="56"
                        Height="56"
                        Stretch="Uniform" />
                    <TextBlock Text="{Binding Name}"
                            Margin="0,4,0,0"
                            TextWrapping="Wrap"
                            TextTrimming="CharacterEllipsis"
                            TextAlignment="Center"
                            FontSize="11" />
                </StackPanel>
            </Border>
        </Button>
        </DockPanel>
</UserControl>